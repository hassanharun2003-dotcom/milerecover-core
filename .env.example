# MileRecover environment template — DOCUMENTATION ONLY
# Copy to .env locally only when a future phase requires it.
# Never commit .env files. No real values belong in Git.
#
# Providers below are NOT selected in Phase 0. Names are illustrative categories only.

# --- Application (future mobile) ---
# APP_ENV=development
# APP_LOG_LEVEL=info

# --- Backend (future modular monolith) ---
# BACKEND_PORT=3000
# BACKEND_PUBLIC_URL=https://example.invalid

# --- Database (future server) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/milerecover

# --- Object storage (future exports / evidence archives) ---
# OBJECT_STORAGE_BUCKET=example-bucket-name
# OBJECT_STORAGE_REGION=us-east-1

# --- Authentication (future) ---
# OAUTH_APPLE_CLIENT_ID=not-configured
# OAUTH_GOOGLE_CLIENT_ID=not-configured
# JWT_SIGNING_KEY=generate-locally-do-not-commit

# --- Subscriptions (future — App Store / Google Play only at launch) ---
# APP_STORE_SHARED_SECRET=not-configured
# GOOGLE_PLAY_SERVICE_ACCOUNT=not-configured
# ENTITLEMENT_WEBHOOK_SECRET=not-configured

# --- Maps / geocoding (future — vendor not selected) ---
# MAPS_API_KEY=not-configured
# GEOCODING_API_KEY=not-configured

# --- Analytics (future — vendor not selected) ---
# ANALYTICS_WRITE_KEY=not-configured

# --- Crash reporting (future — vendor not selected) ---
# CRASH_REPORTING_DSN=not-configured

# --- Notifications (future) ---
# FCM_SERVER_KEY=not-configured
# APNS_KEY_ID=not-configured

# Mobile note: API keys bundled in client apps are not confidential.
# Never treat mobile-embedded keys as sufficient protection for sensitive data.
