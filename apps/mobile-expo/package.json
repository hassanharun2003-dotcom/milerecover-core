{
  "name": "@milerecover/mobile-expo",
  "version": "0.1.0-expo-foundation",
  "private": true,
  "description": "MileRecover Expo development-build application",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "deps:validate": "npx expo install --check",
    "config:validate": "expo config --type public",
    "export:validate": "expo export --platform android --output-dir .expo-export-check",
    "update:preview": "APP_VARIANT=preview npx --yes eas-cli@latest update --channel preview-foundation-0.2.15 --environment preview --message \"preview OTA (APP_VARIANT=preview)\" --non-interactive",
    "smoke:android-launch": "bash ./scripts/android-launch-smoke.sh",
    "gate:android-apk": "bash ./scripts/android-apk-release-gate.sh",
    "sign:android-apk": "bash ./scripts/sign-android-apk.sh",
    "update:production": "APP_VARIANT=production npx --yes eas-cli@latest update --channel production --environment production --message \"production OTA (APP_VARIANT=production)\" --non-interactive",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "eas-build-pre-install": "node ./scripts/sync-dev-client-autolinking.cjs"
  },
  "dependencies": {
    "@babel/runtime": "~7.29.0",
    "@expo/vector-icons": "15.1.1",
    "@milerecover/config": "*",
    "@milerecover/domain": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "16.1.4",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~57.0.9",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.5",
    "expo-build-properties": "~57.0.8",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-location": "~57.0.7",
    "expo-notifications": "~57.0.8",
    "expo-print": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.1",
    "expo-task-manager": "~57.0.7",
    "expo-updates": "~57.0.11",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-maps": "1.29.0",
    "react-native-purchases": "10.6.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@milerecover/domain$": "<rootDir>/../../packages/domain/src/index.ts",
      "^@milerecover/config$": "<rootDir>/../../packages/config/src/index.ts",
      "^@babel/runtime/(.*)$": "<rootDir>/../../node_modules/@babel/runtime/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*)"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2"
}
